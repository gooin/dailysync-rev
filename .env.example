# 佳明中国区账号密码（示例值仅作格式参考，请改成自己的账号密码；对应 https://connect.garmin.cn/）
# 注意：值不要带引号或分号——docker run --env-file 不会剥引号、分号会被当成值的一部分（会变成错误密码或 NaN 参数）
GARMIN_USERNAME_DEFAULT=example@example.com
GARMIN_PASSWORD_DEFAULT=password

# 佳明国际区账号密码（示例值仅作格式参考，请改成自己的账号密码；对应 https://connect.garmin.com/）
GARMIN_GLOBAL_USERNAME_DEFAULT=example@example.com
GARMIN_GLOBAL_PASSWORD_DEFAULT=password

# 活动历史迁移配置：每次迁移多少条活动，以及从第几条活动开始
GARMIN_MIGRATE_NUM_DEFAULT=100
GARMIN_MIGRATE_START_DEFAULT=0
# 自动翻页开关：false=只跑一批（从 START 起 NUM 条，调试用）；true 或不填=自动翻页直到迁完（默认）
GARMIN_MIGRATE_AUTO_PAGE=true

# Wellness 健康数据同步配置，默认关闭；需要同步步数、睡眠、HRV、压力等健康数据时改为 true
# 注意：目标账号需要先人工绑定/连接一台支持健康数据的 Garmin 设备，否则上传会报 419
GARMIN_SYNC_WELLNESS=false

# 日常同步时检查最近几天的健康数据
GARMIN_WELLNESS_SYNC_DAYS=1

# 历史迁移健康数据天数；0 表示不迁移历史健康数据
GARMIN_WELLNESS_MIGRATE_DAYS=0

# 历史迁移从今天往前跳过多少天开始；0 表示从今天开始
GARMIN_WELLNESS_MIGRATE_START_DAYS=0
